# Postgres
DATABASE_URL="postgresql://harsh:yourbuddy@localhost:5432/yourbuddy"

# --- The first account ------------------------------------------------------
# Signup is open, so accounts are normally created at /signup. These only seed
# the original account — the one whose entries predate the login screen.
# Without APP_USER_PASSWORD that account exists but cannot sign in; set it and
# run `npm run db:seed`, or use `npm run db:set-password -- <email> <password>`.
APP_USER_EMAIL="harshmishra070303@gmail.com"
APP_USER_NAME="Harsh"
APP_USER_PASSWORD=""

# Where uploaded images and voice notes are written (local disk adapter).
# Files are keyed under u/<userId>/… so each account owns a subtree.
STORAGE_DIR="./storage"

# Photo and voice uploads need a real, writable, persistent disk. Serverless
# hosts have a read-only filesystem, so this fails closed: unset means the
# upload controls are hidden and the actions refuse files with a clear message,
# instead of throwing EROFS after the entry has already been saved.
# Set to "true" anywhere STORAGE_DIR actually persists.
UPLOADS_ENABLED="true"

# Per-account ceiling on stored photos and voice notes. Set to 0 for no limit —
# reasonable when you're the only one using it, less so once signup is open and
# a single voice note can be 25 MB.
USER_STORAGE_QUOTA_MB="500"

# --- Voice transcription (optional) ---------------------------------------
# Leave unset and voice notes still record, play back, and save — their
# transcript is simply marked PENDING and can be run later from the entry.
# Supported providers: "openai" | "none"
TRANSCRIPTION_PROVIDER="none"
OPENAI_API_KEY=""
OPENAI_TRANSCRIBE_MODEL="whisper-1"
