// YourBuddy — v2 schema (multi-user)
//
// Design notes that trace back to IDEA.md:
//  * Every table carries a user identity — the §3 precaution, now cashed in:
//    opening the app up was a login screen, not a migration of every table.
//  * Accounts are fully private. There is no row anywhere that two users can
//    both reach, which is why every query filters on `userId` and there is no
//    share/membership table to get wrong.
//  * Entries have TWO dates: `createdAt` (when you wrote it) and `entryDate`
//    (what day it is *about*). They are not interchangeable — the dated shelf
//    orders by entryDate, the sort control sorts by createdAt (§7).
//  * `entryDate == null` IS the undated shelf. Making it a real NULL means the
//    database enforces the split instead of every query remembering a flag.
//  * `priorEntryDate` remembers the date that was removed, so the remove-date
//    gesture is losslessly reversible (§5).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Identity
// ============================================================

model User {
  id String @id @default(cuid())
  // Always stored lower-cased and trimmed. Without that, `A@x.com` and
  // `a@x.com` become two accounts holding two halves of one person's journal.
  email String @unique
  name  String?

  // Nullable on purpose. Accounts created before password auth existed — and
  // any created by a script — have no password and cannot sign in until one is
  // set (`npm run db:set-password`). A null hash is never treated as "matches".
  passwordHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sessions    Session[]
  entries     Entry[]
  trackers    Tracker[]
  trackerLogs TrackerLog[]
  attachments Attachment[]
  reminders   Reminder[]
}

// ============================================================
// Sessions — database-backed, so sign-out is real
// ============================================================

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 of the session token. The raw token exists only inside the user's
  // cookie, so a leaked database dump holds nothing that can be replayed as a
  // login. Hashed rather than encrypted because we only ever need to *look it
  // up*, never to read it back.
  tokenHash String @unique

  expiresAt DateTime
  // Extended as the session is used, which is what makes the window sliding.
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  // Shown on the settings page so "sign out everywhere" is an informed choice.
  userAgent    String?

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// Entries
// ============================================================

model Entry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String?
  // Always text. Voice transcripts are appended here so that *everything*
  // exists as text and is reachable by search (§4).
  body  String @default("")
  // The same words carrying their bold/italic/underline marks, as the small
  // HTML subset in `src/lib/rich-text.ts`. NULL whenever nothing is formatted,
  // which is most entries. `body` stays the copy search reads, so putting a
  // mark on a sentence can never make it unfindable.
  bodyRich String?

  // When it was written. Never changes.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // What day it is about. NULL => undated shelf.
  entryDate      DateTime? @db.Date
  // The date it had before it was removed, so the gesture is reversible.
  priorEntryDate DateTime? @db.Date

  attachments Attachment[]
  reminder    Reminder?

  @@index([userId, entryDate])
  @@index([userId, createdAt])
}

// ============================================================
// Attachments (images + voice notes)
// ============================================================

enum AttachmentKind {
  IMAGE
  AUDIO
}

enum TranscriptStatus {
  NOT_APPLICABLE // images
  PENDING // audio saved, no transcription provider configured yet
  DONE
  FAILED
}

model Attachment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind       AttachmentKind
  // Opaque key resolved by the storage adapter (local disk in v1).
  storageKey String
  mimeType   String
  sizeBytes  Int
  // Original client filename, for display only.
  fileName   String?
  // Audio only.
  durationSeconds Int?

  transcriptStatus TranscriptStatus @default(NOT_APPLICABLE)
  transcript       String?
  transcriptError  String?

  entryId String?
  entry   Entry?  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  trackerLogId String?
  trackerLog   TrackerLog? @relation(fields: [trackerLogId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([trackerLogId])
  @@index([userId, transcriptStatus])
}

// ============================================================
// Reminders — opt-in, in-app only, resolved on load (§7)
// ============================================================

model Reminder {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entryId String @unique
  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  remindAt    DateTime
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, remindAt])
}

// ============================================================
// Trackers
// ============================================================

enum TrackerCadence {
  DAILY
  OCCASIONAL
}

enum TrackerLogType {
  BINARY
  NUMBER
  TEXT
}

model Tracker {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  cadence TrackerCadence @default(DAILY)
  logType TrackerLogType
  // Required for NUMBER trackers — "80" is meaningless without it (§4).
  unit    String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  logs TrackerLog[]

  @@index([userId, archivedAt])
}

model TrackerLog {
  id String @id @default(cuid())

  // A real foreign key, not just a column. Check-ins reached the user only
  // through their tracker before; with more than one account on the box, the
  // ownership column that every query filters on should be one the database
  // enforces too.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trackerId String
  tracker   Tracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)

  // The day this check-in counts for (backdatable).
  logDate DateTime @db.Date

  // Exactly one of these is set, per the parent tracker's logType.
  boolValue Boolean?
  numValue  Float?
  textValue String?

  // The optional note is the raw material for effort-vs-outcome analysis (§4).
  note String?

  createdAt DateTime @default(now())

  attachments Attachment[]

  @@index([trackerId, logDate])
  @@index([userId, logDate])
}
